# GitHub Linguist: keep Flutter platform scaffolding out of language stats.
# Dart source files remain counted as Dart.
*.dart linguist-language=Dart

# Flutter-generated platform projects often contain C++, CMake, Objective-C,
# Swift, Java, Kotlin, Gradle, and XML that should not dominate the repo.
/android/** linguist-vendored
/ios/** linguist-vendored
/linux/** linguist-vendored
/macos/** linguist-vendored
/windows/** linguist-vendored
/build/** linguist-generated

# Extra guardrails in case generated C/C++/CMake files live elsewhere.
*.c linguist-vendored
*.cc linguist-vendored
*.cpp linguist-vendored
*.cxx linguist-vendored
*.h linguist-vendored
*.hpp linguist-vendored
*.cmake linguist-vendored
CMakeLists.txt linguist-vendored
**/CMakeLists.txt linguist-vendored
